{
  "manifest_version": 3,
  "name": "GitHub PR Stacks",
  "version": "0.2.0",
  "description": "Groups pull requests on GitHub's PR list by stack, ordered bottom to top, with the stack's tickets.",
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*", "https://api.github.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["settings.js", "stacks.js", "tickets.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
