{
  "manifest_version": 3,
  "name": "GitHub PR Stacks",
  "version": "1.0.0",
  "description": "Groups GitHub's pull request list by stack, ordered bottom to top, with ticket keys in each stack header. No data collected.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*.atlassian.net/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["settings.js", "stacks.js", "tickets.js", "problems.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
